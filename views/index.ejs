<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="/js/index.js" defer></script>
    <title>Members Only</title>
  </head>
  <body>
    <% if (!locals.currentUser) {%>
      <a href="/register">register</a>
      <a href="/login">login</a>
    <%} else {%>
    <% if (locals.currentUser.membership_status !== "member") {%>
      <a href="/join">join</a>
    <%} else {%>
      <div>hello <%= currentUser.username %></div>
    <%}%>
      <a href="/messages/new">create message</a>
      <a href="/logout">logout</a>
    <%}%>
    <h1>list of messages</h1>
    <ul>
      <% for (let message of messages) { %>
      <%- include("partial/message", {id: message.id, title: message.title, body: message.body, author: message.author, date: message.created_at, isMember: locals.currentUser?.membership_status === "member"}) %>
      <%}%>
    </ul>
  </body>
</html>
