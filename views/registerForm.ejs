<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="/css/form.css" rel="stylesheet" />
    <title>Register</title>
  </head>
  <body>
    <div class="content">
      <h1>Register</h1>
      <form action="/register" method="POST">
        <%- include("partial/errors")%>
        <div class="form-group">
          <label for="firstname">First name</label>
          <input id="firstname" type="text" name="firstname" value="<%=locals.user? user.firstname: ""%>" required/>
        </div>
        <div class="form-group">
          <label for="lastname">Last name</label>
          <input id="lastname" type="text" name="lastname" value="<%=locals.user? user.lastname: ""%>" required/>
        </div>
        <div class="form-group">
          <label for="username">Username</label>
          <input id="username" type="text" name="username" value="<%=locals.user? user.username: "" %>" required />
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input id="password" type="password" name="password" required/>
        </div>
        <div class="form-group">
          <label for="confirm">Confirm password</label>
          <input id="confirm" type="password" name="confirm" required/>
        </div>
        <button type="submit">Register</button>
      </form>
      <a href="/">Back to message list</a>
    </div>

  </body>
</html>
 
